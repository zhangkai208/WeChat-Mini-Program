/* 卡片内容垂直 + 水平居中 */
.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60rpx 36rpx;
}

/* 头像：加大 + 白边 + 橘色光晕（呼应主题色） */
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 24rpx;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(232, 168, 124, 0.4);
}

/* 昵称 */
.nick {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

/* 副标题 */
.sub {
  font-size: 24rpx;
  color: #e8a87c;
  margin-bottom: 36rpx;
}

/* 退出按钮：淡色描边款，不抢主视觉 */
.btn {
  width: 60%;
  background: #fff;
  color: #999;
  border: 2rpx solid #eee;
  font-size: 28rpx;
}

.muted { color: #999; margin-bottom: 10rpx; }
.tip { color: #bbb; font-size: 24rpx; text-align: center; margin-top: 40rpx; }
